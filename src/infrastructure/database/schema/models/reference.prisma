model Country {
  code          String         @id @db.VarChar(10)
  name          String         @db.VarChar(100)
  phonePrefix   String?        @map("phone_prefix") @db.VarChar(10)
  flagEmoji     String?        @map("flag_emoji") @db.VarChar(10)
  Destinations  Destination[]
  users         User[]
  userLocations UserLocation[]

  @@map("countries")
}
