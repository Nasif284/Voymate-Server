enum ChatType {
    DIRECT
}
enum ChatMessageType {
    TEXT
    IMAGE
}

enum MessageStatus {
    SENT
    DELIVERED
    READ
}
model ChatConversation {
    id String @id @default(uuid()) @db.Uuid

    type ChatType @default(DIRECT)

    userAId String? @map("user_a_id") @db.Uuid
    userBId String? @map("user_b_id") @db.Uuid

    directKey String? @unique @map("direct_key") @db.VarChar(100)

    userA User? @relation("ChatUserA",fields: [userAId],references: [id],onDelete: Cascade)
    userB User? @relation("ChatUserB",fields: [userBId],references: [id],onDelete: Cascade)

    messages ChatMessage[]

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    @@index([type])
    @@index([userAId])
    @@index([userBId])
    @@map("chat_conversations")
}

model ChatMessage {
    id String @id @default(uuid()) @db.Uuid

    type ChatMessageType @default(TEXT)

    conversationId String @map("conversation_id") @db.Uuid
    senderId String @map("sender_id") @db.Uuid

    content String

    status MessageStatus @default(SENT)
    readAt DateTime? @map("read_at") @db.Timestamptz(6)

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

    conversation ChatConversation @relation(fields: [conversationId],references: [id],onDelete: Cascade)

    attachment ChatMessageAttachment?

    sender User @relation(fields: [senderId],references: [id],onDelete: Cascade)

    @@index([conversationId, createdAt])
    @@index([conversationId, senderId, status])
    @@index([senderId])
    @@map("chat_messages")
}

model ChatMessageAttachment {
    id String @id @default(uuid()) @db.Uuid

    messageId String @unique @map("message_id") @db.Uuid

    storageKey String @map("storage_key")

    mimeType String @map("mime_type")
    fileName String? @map("file_name")
    fileSize Int? @map("file_size")

    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

    message ChatMessage @relation( fields: [messageId], references: [id], onDelete: Cascade)

    @@index([storageKey])
    @@map("chat_message_attachments")
}